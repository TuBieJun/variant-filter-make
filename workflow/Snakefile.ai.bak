configfile: "config/config.yaml"

import csv
import os


def normalize_cell(value):
    if value is None:
        return None
    value = value.strip()
    return None if value == "." or value == "" else value


def load_samplesheet(path):
    with open(path, newline="", encoding="utf-8") as handle:
        reader = csv.DictReader(handle, delimiter="\t")
        rows = []
        for raw in reader:
            row = {k: normalize_cell(v) for k, v in raw.items()}
            if any(v is not None for v in row.values()):
                rows.append(row)
        return rows


def normalize_mode(value):
    return (value or "").strip().lower()


def get_test_base(path):
    if path is None:
        return None
    base = os.path.basename(path)
    if base.endswith(".vcf.gz"):
        return base[:-7]
    if base.endswith(".vcf"):
        return base[:-4]
    return base


def unique_value(rows, key, default=None):
    values = {row[key].strip() for row in rows if row.get(key) and row[key].strip()}
    if len(values) > 1:
        raise ValueError(f"Found multiple values for '{key}': {sorted(values)}")
    return values.pop() if values else default


SAMPLE_ROWS = load_samplesheet(config["samplesheet"])
TRAIN_ROWS = [row for row in SAMPLE_ROWS if normalize_mode(row.get("mode")) == "train"]
HAP_ROWS = [row for row in SAMPLE_ROWS if normalize_mode(row.get("mode")) in {"hap", "test"}]

if not TRAIN_ROWS:
    raise ValueError("No training rows found in samplesheet")
if not HAP_ROWS:
    raise ValueError("No hap rows found in samplesheet")

TRAIN_SAMPLE_IDS = sorted({row["sample_id"] for row in TRAIN_ROWS})
HAP_SAMPLE_IDS = [row["sample_id"] for row in HAP_ROWS]

EXTRACT_CONFIG = config["extract_features"]
TRAIN_CONFIG = config["train_model"]
APPLY_CONFIG = config["apply_model"]
HAP_CONFIG = config["hap_py"]
PLOT_CONFIG = config["plot"]

PREFIX = config.get("prefix", TRAIN_CONFIG.get("model_name", "default"))
MODEL_NAMES = TRAIN_CONFIG.get("model_names") or ([TRAIN_CONFIG["model"]] if TRAIN_CONFIG.get("model") else [])
if not MODEL_NAMES:
    raise ValueError("train_model.model_names or train_model.model must be specified in config")

PLOT_OUTPUTS = {
    "snp": PLOT_CONFIG.get("snp_output") or f"results/hap_plot/{PREFIX}.snp.hap.summary.png",
    "indel": PLOT_CONFIG.get("indel_output") or f"results/hap_plot/{PREFIX}.indel.hap.summary.png",
}

HAP_PLOT_TAGS = PLOT_CONFIG.get("plot_tags")
if HAP_PLOT_TAGS is None:
    HAP_PLOT_TAGS = [model_name for _ in HAP_SAMPLE_IDS for model_name in MODEL_NAMES]
if len(HAP_PLOT_TAGS) != len(HAP_SAMPLE_IDS) * len(MODEL_NAMES):
    raise ValueError(
        f"plot_tags length must match hap sample files ({len(HAP_SAMPLE_IDS) * len(MODEL_NAMES)}), got {len(HAP_PLOT_TAGS)}"
    )

TRAIN_SAMPLE_BY_ID = {row["sample_id"]: row for row in TRAIN_ROWS}
HAP_SAMPLE_BY_ID = {row["sample_id"]: row for row in HAP_ROWS}
TEST_BASE_BY_ID = {row["sample_id"]: get_test_base(row["test_vcf"]) for row in HAP_ROWS}
MODE_BY_ID = {row["sample_id"]: normalize_mode(row["mode"]) for row in HAP_ROWS}


rule all:
    input:
        PLOT_OUTPUTS["snp"],
        PLOT_OUTPUTS["indel"]


rule extract_features:
    input:
        train_vcf=lambda wc: TRAIN_SAMPLE_BY_ID[wc.sample_id]["train_vcf"],
        train_truth_vcf=lambda wc: TRAIN_SAMPLE_BY_ID[wc.sample_id]["train_truth_vcf"],
        train_bed=lambda wc: TRAIN_SAMPLE_BY_ID[wc.sample_id]["train_bed"],
    output:
        snp_matrix=f"results/features/{PREFIX}_{{sample_id}}_snp_feature_matrix.tsv",
        indel_matrix=f"results/features/{PREFIX}_{{sample_id}}_indel_feature_matrix.tsv",
    params:
        prefix=lambda wc: f"results/features/{PREFIX}_{wc.sample_id}",
        vcf_filter_flag=EXTRACT_CONFIG["vcf_filter_flag"],
        info_flags_snp=EXTRACT_CONFIG["info_flags_snp"],
        info_flags_indel=EXTRACT_CONFIG["info_flags_indel"],
    shell:
        """
        python workflow/scripts/extract_features.py \
            {input.train_vcf} \
            {input.train_truth_vcf} \
            {input.train_bed} \
            {params.prefix} \
            --sample-id {wildcards.sample_id} \
            --vcf-filter-flag "{params.vcf_filter_flag}" \
            --info-flags-snp "{params.info_flags_snp}" \
            --info-flags-indel "{params.info_flags_indel}"
        """


rule train_model:
    input:
        features=lambda wc: expand("results/features/{prefix}_{sample_id}_{variant_type}_feature_matrix.tsv", prefix=PREFIX, sample_id=TRAIN_SAMPLE_IDS, variant_type=[wc.variant_type]),
        config_file=TRAIN_CONFIG["config_file"],
    output:
        model_file=f"results/models/{PREFIX}_{{variant_type}}_{{model_name}}.pkl",
    params:
        info_flags=lambda wc: TRAIN_CONFIG[f"info_flags_{wc.variant_type}"],
        model_name=lambda wc: wc.model_name,
    shell:
        """
        python workflow/scripts/train_model.py \
            -i {input.features} \
            -o {output.model_file} \
            --info-flags "{params.info_flags}" \
            -c {input.config_file} \
            --model {params.model_name} \
        """


rule apply_model:
    input:
        test_vcf=lambda wc: HAP_SAMPLE_BY_ID[wc.sample_id]["test_vcf"],
        model_file=lambda wc: f"results/models/{PREFIX}_{wc.variant_type}_{wc.model_name}.pkl",
    output:
        vcf=f"results/apply/{{test_base}}.{PREFIX}.{{mode}}.apply.{{variant_type}}.{{model_name}}.vcf.gz",
        vcf_index=f"results/apply/{{test_base}}.{PREFIX}.{{mode}}.apply.{{variant_type}}.{{model_name}}.vcf.gz.tbi",
    params:
        filter_name=lambda wc: f"{APPLY_CONFIG['filter_name_prefix']}_{wc.variant_type.upper()}_FAIL",
        overwrite_flag="-F" if APPLY_CONFIG["overwrite_filter"] else "",
        batch_size=APPLY_CONFIG["batch_size"],
    shell:
        """
        python workflow/scripts/apply_model.py \
            -i {input.test_vcf} \
            -m {input.model_file} \
            -o {output.vcf} \
            -t {wildcards.variant_type} \
            -f {params.filter_name} \
            -b {params.batch_size} \
            {params.overwrite_flag}
        tabix -f {output.vcf}
        """


rule merge_snp_indel:
    input:
        snp_vcf=f"results/apply/{{test_base}}.{PREFIX}.{{mode}}.apply.snp.{{model_name}}.vcf.gz",
        indel_vcf=f"results/apply/{{test_base}}.{PREFIX}.{{mode}}.apply.indel.{{model_name}}.vcf.gz",
    output:
        vcf=f"results/apply/{{test_base}}.{PREFIX}.{{mode}}.apply.{{model_name}}.vcf.gz",
        vcf_index=f"results/apply/{{test_base}}.{PREFIX}.{{mode}}.apply.{{model_name}}.vcf.gz.tbi",
    shell:
        """
        bcftools concat -a -O z -W -o {output.vcf} {input.snp_vcf} {input.indel_vcf}
        tabix -f {output.vcf}
        """


rule hap_py:
    input:
        query_vcf=f"results/apply/{{test_base}}.{PREFIX}.{{mode}}.apply.{{model_name}}.vcf.gz",
        truth_vcf=lambda wc: HAP_SAMPLE_BY_ID[wc.sample_id]["hap_truth_vcf"],
        confident_bed=lambda wc: HAP_SAMPLE_BY_ID[wc.sample_id]["test_bed"],
        ref_fasta=HAP_CONFIG["ref_fasta"],
    output:
        summary=f"results/happy/{{sample_id}}.{PREFIX}.{{mode}}.{{model_name}}.summary.csv",
    threads: HAP_CONFIG["threads"],
    shell:
        """
        conda run -n hap.py hap.py --threads {threads} \
            -r {input.ref_fasta} \
            -f {input.confident_bed} \
            -o results/happy/{wildcards.sample_id}.{PREFIX}.{mode}.{wildcards.model_name} \
            {input.truth_vcf} \
            {input.query_vcf}
        """


rule plot_hap:
    input:
        hap_summary_files=lambda wc: [
            f"results/happy/{sample_id}.{PREFIX}.{MODE_BY_ID[sample_id]}.{model_name}.summary.csv"
            for sample_id in HAP_SAMPLE_IDS
            for model_name in MODEL_NAMES
        ],
    output:
        snp=PLOT_OUTPUTS["snp"],
        indel=PLOT_OUTPUTS["indel"],
    params:
        hap_summary_files=lambda wc: " ".join([
            f"results/happy/{sample_id}.{PREFIX}.{MODE_BY_ID[sample_id]}.{model_name}.summary.csv"
            for sample_id in HAP_SAMPLE_IDS
            for model_name in MODEL_NAMES
        ]),
        sample_ids=lambda wc: " ".join([sample_id for sample_id in HAP_SAMPLE_IDS for _ in MODEL_NAMES]),
        tags=lambda wc: " ".join(HAP_PLOT_TAGS),
        filter_value=PLOT_CONFIG["filter"],
    shell:
        """
        python workflow/scripts/plot_hap.py -i {params.hap_summary_files} \
            -s {params.sample_ids} \
            -t {params.tags} \
            --type SNP \
            --filter {params.filter_value} \
            -o {output.snp}
        python workflow/scripts/plot_hap.py -i {params.hap_summary_files} \
            -s {params.sample_ids} \
            -t {params.tags} \
            --type INDEL \
            --filter {params.filter_value} \
            -o {output.indel}
        """
